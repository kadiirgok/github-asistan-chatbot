# Bu dosyayı ".env" olarak kopyala ve değerleri doldur.

# --- LLM sağlayıcıları (OpenAI-uyumlu, yedek zincir: DeepSeek -> Groq) ---
# Birincil: DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Yedek: Groq (https://console.groq.com) — boş bırakılırsa sadece DeepSeek kullanılır
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# LLM çağrı ayarları (isteğe bağlı).
# GITHUB_RAG_LLM_TIMEOUT=120
# GITHUB_RAG_LLM_RETRIES=1

# --- Embedding / depolama ---
# Embedding modeli (varsayılan: paraphrase-multilingual-MiniLM-L12-v2)
# GITHUB_RAG_EMBEDDING_MODEL=

# ChromaDB klasörü (varsayılan: chroma_db)
# GITHUB_RAG_CHROMA_DIR=

# GitHub API limitini 60/saat -> 5000/saat'e çıkarır (repo sayısı fazlaysa önerilir).
# https://github.com/settings/tokens adresinden salt-okunur bir token oluştur.
# GITHUB_TOKEN=

# LLM cevap uzunluğu (isteğe bağlı). Varsayılan: 512
# GITHUB_RAG_MAX_TOKENS=512
